#!/usr/bin/env bash
# Local gate: the checks CI runs, plus the real-helix load check that CI
# cannot run because the Steel fork is not packaged.
set -euo pipefail

echo "[pre-push] format check..."
nixfmt --check flake.nix

echo "[pre-push] tests..."
steel tests/rust-test.scm
steel tests/cpp-test.scm

echo "[pre-push] editor half compiles..."
make compile-check

echo "[pre-push] cog loads in helix..."
make helix-check

echo "[pre-push] commands run in helix..."
make integration-check

echo "[pre-push] all checks passed."
